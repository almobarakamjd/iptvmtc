<?xml version="1.0" encoding="utf-8"?>
<!-- إعداد خدمة الإتاحة الخاصة بتبديل القنوات بالريموت (RemoteKeyAccessibilityService).
     canRequestFilterKeyEvents هو الإذن الحقيقي المهم هنا — يسمح لخدمتنا تعترض ضغطات الريموت
     حتى وتطبيق آخر (VLC/MX) هو من له التركيز على الشاشة. لا نطلب أي صلاحية قراءة محتوى الشاشة. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFlags="flagRequestFilterKeyEvents"
    android:canRequestFilterKeyEvents="true"
    android:notificationTimeout="100"
    android:description="@string/remote_zap_service_desc" />
